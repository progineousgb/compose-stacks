# Empty values are required secrets. docker compose refuses to start until each one is set.
NEXTCLOUD_HOST=cloud.example.com
ADMIN_USER=admin
ADMIN_PASSWORD=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Docker bridge networks. Narrow this to the proxy network subnet if you know it.
TRUSTED_PROXIES=172.16.0.0/12
PHP_UPLOAD_LIMIT=2G
PHP_MEMORY_LIMIT=512M
