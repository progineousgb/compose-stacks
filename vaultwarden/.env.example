VW_HOST=vault.example.com
# Set to true, create your account, then set back to false and recreate the container.
SIGNUPS_ALLOWED=false
# Leave empty to disable /admin. Otherwise use an Argon2 hash from:
#   docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash
# and escape each $ as $$ in this file.
ADMIN_TOKEN=
